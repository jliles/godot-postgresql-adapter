[configuration]

entry_symbol = "postgresql_adapter_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "bin/lib_postgresql_adapter.linux.template_debug.double.x86_64.so"
linux.release.x86_64 = "bin/lib_postgresql_adapter.linux.template_release.double.x86_64.so"

linux.debug.arm64 = "bin/lib_postgresql_adapter.linux.template_debug.double.arm64.so"
linux.release.arm64 = "bin/lib_postgresql_adapter.linux.template_release.double.arm64.so"

[dependencies]

linux.debug.x86_64 = {}
linux.release.x86_64 = {}

linux.debug.arm64 = {}
linux.release.arm64 = {}
